{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@happy/erp",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "regions": ["pdx1"],
  "crons": [
    {
      "path": "/api/cron/sunat",
      "schedule": "*/15 * * * *"
    }
  ]
}
